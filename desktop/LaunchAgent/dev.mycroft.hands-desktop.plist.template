<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent for Mycroft Hands.app, the desktop helper. Runs `hands-desktop serve` from the app in the logged-in
  user's GUI (Aqua) session, where it can hold the Accessibility and Screen Recording permissions. `hands install`
  fills in the placeholders (hands/src/ui/app.rs drops this comment), writes the result to
  ~/Library/LaunchAgents/dev.mycroft.hands-desktop.plist, and loads it with
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.mycroft.hands-desktop.plist

  Placeholders:
    {{HANDS_DESKTOP_BIN}}  absolute path of the binary in the app,
                           ~/Applications/Mycroft Hands.app/Contents/MacOS/hands-desktop
    {{HANDS_STATE_DIR}}    hands' state directory (holds desktop.sock and the log),
                           for example /Users/me/Library/Application Support/hands
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.mycroft.hands-desktop</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HANDS_DESKTOP_BIN}}</string>
		<string>serve</string>
		<string>--socket</string>
		<string>{{HANDS_STATE_DIR}}/desktop.sock</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HANDS_STATE_DIR</key>
		<string>{{HANDS_STATE_DIR}}</string>
	</dict>
	<!-- Only in a logged-in GUI session: Accessibility and UI events need one. -->
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>{{HANDS_STATE_DIR}}/desktop.log</string>
	<key>StandardErrorPath</key>
	<string>{{HANDS_STATE_DIR}}/desktop.log</string>
</dict>
</plist>
